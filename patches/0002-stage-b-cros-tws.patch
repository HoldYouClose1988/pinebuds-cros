diff --git a/config/open_source/target.mk b/config/open_source/target.mk
--- a/config/open_source/target.mk
+++ b/config/open_source/target.mk
@@ -89,9 +89,18 @@
 export ANC_ASSIST_ENABLED ?= 0
 ##### ANC DEFINE END ######
 
-#### CROS / Stage A ######
-# 1 = experimental FF mic → speaker loopback (bring-up)
+#### CROS / Stage A + B ######
+# Stage A: experimental FF mic → local speaker loopback
+# Stage B: experimental cross-bud CROS (poor FF mic → good speaker over TWS)
 export CROS_STAGE_A ?= 0
+export CROS_STAGE_B ?= 0
+# Default poor side for Stage B: RIGHT bud (1). Set 0 for LEFT.
+export CROS_POOR_IS_RIGHT ?= 1
+ifeq ($(CROS_STAGE_B),1)
+# Stage B needs FF→ASRMIC remap and larger TWS ctrl packets
+export CROS_STAGE_A := 1
+KBUILD_CPPFLAGS += -DCROS_STAGE_B -DCROS_POOR_IS_RIGHT=$(CROS_POOR_IS_RIGHT)
+endif
 ifeq ($(CROS_STAGE_A),1)
 KBUILD_CPPFLAGS += -DCROS_STAGE_A
 endif
