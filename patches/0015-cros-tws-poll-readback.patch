+void btdrv_reg_op_get_private_tws_poll_interval(uint16_t *poll_interval,
+                                                uint16_t *poll_interval_in_sco) {
+  if (poll_interval) {
+    *poll_interval = 0xffff;
+  }
+  if (poll_interval_in_sco) {
+    *poll_interval_in_sco = 0xffff;
+  }
+  if (!dbg_bt_setting_addr) {
+    return;
+  }
+  if (poll_interval) {
+    *poll_interval = *(volatile uint16_t *)(dbg_bt_setting_addr + 0x40);
+  }
+  if (poll_interval_in_sco) {
+    *poll_interval_in_sco = *(volatile uint16_t *)(dbg_bt_setting_addr + 0x42);
+  }
+}
+
+uint8_t btdrv_reg_op_get_tws_link_duration(void) {
+  if (!dbg_bt_setting_addr) {
+    return 0xff;
+  }
+  return (uint8_t)(*(volatile uint16_t *)(dbg_bt_setting_addr + 0x44) & 0xff);
+}
+
+uint16_t bt_drv_reg_op_get_tpoll(uint8_t linkid) {
+  uint32_t acl_evt_ptr = 0;
+
+  if (!ld_acl_env_addr || linkid >= 3) {
+    return 0xffff;
+  }
+  acl_evt_ptr = *(uint32_t *)(ld_acl_env_addr + linkid * 4);
+  if (!acl_evt_ptr) {
+    return 0xffff;
+  }
+  return *(uint16_t *)(acl_evt_ptr + 0xb8);
+}
