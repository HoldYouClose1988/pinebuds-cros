--- a/services/bt_app/app_bt.cpp
+++ b/services/bt_app/app_bt.cpp
@@ -38,6 +38,9 @@
 #include "hci_api.h"
 #include "hfp_api.h"
 #include "l2cap_api.h"
+#if defined(CROS_STAGE_B)
+#include "cros_bt_log.h"
+#endif
 #include "me_api.h"
 #include "mei_api.h"
 #include "nvrecord.h"
@@ -1557,6 +1560,30 @@
     break;
   }
 
+#if defined(CROS_STAGE_B)
+  {
+    uint8_t sco_evt = btif_me_get_callback_event_type(Event);
+    if (sco_evt == BTIF_BTEVENT_SCO_CONNECT_IND ||
+        sco_evt == BTIF_BTEVENT_SCO_CONNECT_CNF ||
+        sco_evt == BTIF_BTEVENT_SCO_DISCONNECT) {
+      uint8_t sco_err = btif_me_get_callback_event_err_code(Event);
+      bt_bdaddr_t *sco_bd =
+          btif_me_get_callback_event_rem_dev_bd_addr(Event);
+      const char *name =
+          (sco_evt == BTIF_BTEVENT_SCO_CONNECT_IND)    ? "SCO_CONNECT_IND"
+          : (sco_evt == BTIF_BTEVENT_SCO_CONNECT_CNF)  ? "SCO_CONNECT_CNF"
+                                                       : "SCO_DISCONNECT";
+      CROS_LOG(0,
+               "[cros_sco] BTEVENT_%s err=0x%02x rem=%02x:%02x:%02x:%02x:"
+               "%02x:%02x",
+               name, (unsigned)sco_err,
+               sco_bd ? sco_bd->address[0] : 0, sco_bd ? sco_bd->address[1] : 0,
+               sco_bd ? sco_bd->address[2] : 0, sco_bd ? sco_bd->address[3] : 0,
+               sco_bd ? sco_bd->address[4] : 0, sco_bd ? sco_bd->address[5] : 0);
+    }
+  }
+#endif
+
