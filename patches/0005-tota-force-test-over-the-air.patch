diff --git a/services/tota/app_tota.cpp b/services/tota/app_tota.cpp
--- a/services/tota/app_tota.cpp
+++ b/services/tota/app_tota.cpp
@@ -85,8 +85,12 @@ void app_tota_init(void) {
   app_tota_flash_init();
 
   /* set module to access spp callback */
-  // tota_callback_module_set(APP_TOTA_AUDIO_DUMP);
-  tota_callback_module_set(APP_TOTA_ANC);
+#if defined(APP_ANC_TEST)
+  tota_callback_module_set(APP_TOTA_ANC);
+#else
+  /* open_source: no anc_spp_tool — use custom module for phone log sink */
+  tota_callback_module_set(APP_TOTA_CUSTOM);
+#endif
 
 #if (BLE_APP_TOTA)
   app_ble_rx_handler_init();
